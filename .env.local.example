# ─── WEJI ويجي — environment ───────────────────────────────────────────────
# Copy this file to  .env.local  and paste your keys in.
# .env.local is never committed and never sent to the browser.
#
# WEJI runs without any of these in DEMO MODE, so you can see it working first.

# 1. Unsplash — free key from https://unsplash.com/developers
#    ("New Application" → accept terms → copy the "Access Key")
UNSPLASH_ACCESS_KEY=

# 2. Pexels — free key from https://www.pexels.com/api/
#    (sign up → "Your API Key" → copy)
PEXELS_API_KEY=

# 3. Supabase — phase 2 (accounts, collections, likes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
